# Local development only. Never reuse these credentials in production.
ENVIRONMENT=development
POSTGRES_USER=vehicle
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=vehicle
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://vehicle:local-development-only@127.0.0.1:5432/vehicle
API_BASE_URL=http://127.0.0.1:8000
APP_VERSION=0.1.0
# GIT_SHA and BUILD_TIMESTAMP (timezone-aware ISO8601) are optional build metadata.
# Enable via compose observability override; leave unset in lightweight development.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Phase 7B uses a separate operator credential. Generate a unique secret locally.
# VIP_AGENT_INVESTIGATION_TOKEN=

# Phase 9D controlled serving stays disabled unless all three settings are explicitly provided.
# Use only on a local development/test instance; never expose through public ingress.
# PREDICTION_SERVICE_ENABLED=false
# PREDICTION_OPERATOR_TOKEN=
# PREDICTION_TRUSTED_NETWORKS=127.0.0.0/8,::1/128
# PREDICTION_OPERATOR_VEHICLE_IDS=
#
# Phase 9H private operator BFF is disabled by default. Keep all values server-side.
# Use independent high-entropy secrets for the browser credential and session MAC.
# PREDICTIVE_UI_ENABLED=false
# PREDICTIVE_UI_ORIGIN=http://localhost:3000
# PREDICTIVE_UI_OPERATOR_SECRET=
# PREDICTIVE_UI_SESSION_SECRET=
# PREDICTIVE_UI_ALLOWED_VEHICLE_IDS=
# PREDICTIVE_UI_DEMO_ENABLED=false
# PREDICTIVE_UI_COOKIE_SECURE=false
# The Compose BFF uses an internal network and allows only the web container as a trusted 9D peer.
# If the internal subnet conflicts with your local network, change compose.yaml and the /32 together.

# Phase 7D paid evaluation is explicitly invoked; normal CI never uses these secrets.
VIP_AGENT_SERVICE_TIER=flex
VIP_AGENT_REASONING_EFFORT=low
VIP_7D_MAX_SPEND_USD=2.00
