# Local development only. Never reuse these credentials in production.
ENVIRONMENT=development
POSTGRES_USER=vehicle
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=vehicle
DATABASE_URL=postgresql+asyncpg://vehicle:local-development-only@127.0.0.1:5432/vehicle
API_BASE_URL=http://127.0.0.1:8000
APP_VERSION=0.1.0
# GIT_SHA and BUILD_TIMESTAMP (timezone-aware ISO8601) are optional build metadata.
# Enable via compose observability override; leave unset in lightweight development.
