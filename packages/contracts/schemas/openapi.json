  "info": { "title": "Vehicle Intelligence Platform", "version": "0.1.0" },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/sessions": {
      "get": {
        "operationId": "list_sessions",
        "parameters": [
          {
            "in": "query",
            "name": "vehicle_id",
            "required": false,
            "schema": {
              "anyOf": [
                { "format": "uuid", "type": "string" },
                { "type": "null" }
              ],
              "title": "Vehicle Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/DrivingSession" },
                  "title": "Response List Sessions",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List Sessions"
      },
      "post": {
        "operationId": "create_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SessionCreate" }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DrivingSession" }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Create Session"
      }
    },
    "/api/v1/sessions/{session_id}": {
      "get": {
        "operationId": "get_session",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DrivingSession" }
              }
            },
            "description": "Successful Response"
          },
          "422": {
